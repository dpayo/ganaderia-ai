# Copia este archivo a .env y cambia TODOS los secretos.
ENVIRONMENT=development

POSTGRES_DB=ganaderia
POSTGRES_USER=ganaderia
POSTGRES_PASSWORD=cambia-esta-contraseña

# Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-48

S3_BUCKET=ganaderia-photos
S3_ACCESS_KEY=ganaderia
S3_SECRET_KEY=cambia-esta-clave-minio

# OCR: tesseract (incluido, gratis) | google_vision (más preciso, requiere clave) | none
OCR_PROVIDER=tesseract
GOOGLE_VISION_API_KEY=
